{
  "name": "monopoly",
  "private": true,
  "version": "0.1.0",
  "description": "Online multiplayer Monopoly game",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @monopoly/server dev\" \"pnpm --filter @monopoly/client dev\"",
    "build": "pnpm --filter @monopoly/shared build && pnpm --filter @monopoly/game-engine build && pnpm --filter @monopoly/config build && pnpm --filter @monopoly/server build && pnpm --filter @monopoly/client build",
    "setup": "pnpm install && pnpm run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0"
}
